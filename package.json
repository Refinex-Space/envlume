{
  "name": "envlume-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": "24.14.1" },
  "scripts": {
    "dev": "pnpm --filter @envlume/desktop dev",
    "desktop": "pnpm --filter @envlume/desktop tauri",
    "lint": "pnpm --filter @envlume/desktop lint",
    "typecheck": "pnpm --filter @envlume/desktop typecheck",
    "unit": "pnpm --filter @envlume/desktop unit && node --test tests/contracts/schemas.test.mjs",
    "build": "pnpm --filter @envlume/desktop build"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
